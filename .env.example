# Variables de entorno para conectar Mi Libreta con Supabase (Opcional para modo local, necesario para sincronización en la nube entre celular y computadora)
#
# IMPORTANTE DE SEGURIDAD:
# - NUNCA coloque aquí la clave administrativa `service_role` ni claves secretas del servidor.
# - El frontend utiliza únicamente la clave pública `anon` protegida por políticas Row Level Security (RLS) en PostgreSQL.

VITE_SUPABASE_URL=https://su-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
